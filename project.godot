; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-project-1"
config/version="0.1.0"
run/main_scene="res://features/ui/level_select/level_select.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
AudioManager="*res://autoload/AudioManager.gd"
TempoControl="*res://autoload/TempoControl.gd"
SaveManager="*res://autoload/SaveManager.gd"
ComfortSettings="*res://autoload/ComfortSettings.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
