; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-project-1"
config/features=PackedStringArray("4.4", "Forward Plus")
config/version="0.1.0"
run/main_scene="res://features/levels/secret_eyes/fluid_demo.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
AudioManager="*res://autoload/AudioManager.gd"
SaveManager="*res://autoload/SaveManager.gd"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[rendering]

renderer/rendering_method="forward_plus"
