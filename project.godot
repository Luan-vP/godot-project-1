; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-project-1"
config/features=PackedStringArray("4.4", "Forward Plus")
config/version="0.1.0"
run/main_scene="res://features/ui/demo_menu/demo_menu.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
AudioManager="*res://autoload/AudioManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
ComfortSettings="*res://autoload/ComfortSettings.gd"

[input]

recentre_tilt={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":67,"key_label":0,"unicode":99,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":8,"pressure":0.0,"pressed":false,"script":null)
]
}

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[rendering]

renderer/rendering_method="forward_plus"
