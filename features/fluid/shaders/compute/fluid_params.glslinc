// Shared declarations for the solve. Every pass takes the same push constant
// block and the same splat buffer layout, so FluidGPU can pack one set of
// parameters per frame and hand it to all of them.
//
// Included, not compiled on its own -- see the passes beside it.

#define TAU 6.283185307179586

// One stirrer or one dab of paint. The two fields mean different things to the
// velocity and dye passes, which is why they are named by position rather than
// by what they carry:
//
//   velocity  slot = (centre UV, impulse in cells/second)
//             shape = (radius in tank heights, in-use flag, 0, 0)
//   dye       slot = (centre UV, radius in tank heights, in-use flag)
//             shape = (pigment RGB, density laid down)
struct Splat {
	vec4 slot;
	vec4 shape;
};

layout(push_constant, std430) uniform Params {
	vec2 texel_size;
	vec2 splat_aspect;
	vec2 ambient_drift;
	vec2 uniform_impulse;
	float time_step;
	float dissipation;
	float vorticity_strength;
	float ambient_strength;
	float ambient_scale;
	float elapsed;
	float max_density;
	int splat_count;
	ivec2 size;
	// nu * dt / cell_width^2 and nu * dt / cell_height^2: the viscous diffusion
	// coefficient per axis, zero when the fluid is inviscid.
	vec2 viscous_alpha;
	// 0 lets fluid slide along walls in the viscosity pass; 1 is no-slip.
	float wall_friction;
	// Non-zero when the tank has no walls and each edge joins the opposite one.
	int wrap_edges;
	vec2 pad_b;
} params;

// Cell centre of an integer coordinate, in UV space.
vec2 cell_uv(ivec2 coord) {
	return (vec2(coord) + 0.5) / vec2(params.size);
}

bool out_of_bounds(ivec2 coord) {
	return coord.x >= params.size.x || coord.y >= params.size.y;
}

// The cell a neighbour lookup lands in. At most one cell past the grid: a
// wrapping tank reads round to the opposite edge, a walled one holds the edge.
ivec2 neighbour(ivec2 coord) {
	if (params.wrap_edges != 0) {
		return (coord + params.size) % params.size;
	}
	return clamp(coord, ivec2(0), params.size - 1);
}

// Where an advection trace-back samples from. A walled tank keeps it off the
// rim; a wrapping one lets it leave one edge and come in at the other.
vec2 source_point(vec2 uv) {
	if (params.wrap_edges != 0) {
		return fract(uv);
	}
	vec2 half_texel = params.texel_size * 0.5;
	return clamp(uv, half_texel, vec2(1.0) - half_texel);
}

// UV offset from a splat's centre, the short way round in a wrapping tank, so
// a stir at one edge also reaches across to the other.
vec2 splat_offset(vec2 uv, vec2 centre) {
	vec2 offset = uv - centre;
	if (params.wrap_edges != 0) {
		offset -= round(offset);
	}
	return offset;
}
